    picoefi \
    0515ccde7a3ac9c52e32c9c21c924a8d50d3261e

clone_repo_commit \
    https://github.com/charlesnicholson/nanoprintf.git \
    nanoprintf \
    bebaecbeaf430e36a2d30d31a2fed4e098388c93

clone_repo_commit \
