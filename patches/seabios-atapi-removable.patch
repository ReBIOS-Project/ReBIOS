diff --git a/tests/README.md b/tests/README.md
new file mode 100644
index 00000000..52545731
--- /dev/null
+++ b/tests/README.md
@@ -0,0 +1,120 @@
+ATAPI removable media checks
+===========================
+
+From the repository root, with GCC and its AddressSanitizer/UBSan runtime:
+
+    gcc -Isrc -Wall -Wextra -Werror -fsanitize=address,undefined -g \
+        tests/atapi-floppy.c -o /tmp/seabios-atapi-floppy-test
+    ASAN_OPTIONS=detect_leaks=0 /tmp/seabios-atapi-floppy-test
+
+The test uses the production model matching and geometry helpers. It checks
+LS-120 identification, case-insensitive configuration matching, truncated
+model names, supported floppy capacities, and rejection of ZIP and invalid
+block sizes. It also checks ZIP100/250 legacy 64-head/32-sector translation
+and preservation of geometry supplied by the host. Leak detection is disabled
+because this test allocates nothing
+and LeakSanitizer cannot run in some traced sandboxes.
+
+Build the ReBIOS CSM configuration with GCC, GNU binutils, make and Python 3:
+
+    cp ../ReBIOS/seabios-config .config
+    make olddefconfig
+    make -j4
+
+Real hardware validation is still required for IDE-to-SATA ATAPI bridges
+and the AHCI controller path. Low-level formatting is rejected.
+
+`etc/floppy-a` and `etc/floppy-b` (ReBIOS's `floppy_a`, `floppy_b`) reserve
+BIOS floppy drives 00h and 01h, A: and B:. They name a drive by part of its
+model, or by its port: its SeaBIOS name (`ata1-0`, `AHCI/2`) or its boot
+order path (`/pci@i0cf8/*@17/drive@2/disk@0`), which tells two drives of one
+model apart. Of several drives a model name matches, the first in boot
+order is taken; the same name for both gives A: to the first and B: to the
+second. A named drive is a floppy drive, a ZIP too. In 86Box, two LS-120s
+named by port (reversed from their channel order) became A: and B: as
+named, and `DISKCOPY A: B:` and `DISKCOMP A: B:` passed; two ZIPs named by
+port became A: and B:.
+
+A ZIP is mapped as the `etc/zip-mode` ROM file says (ReBIOS's `zip_mode`):
+in auto mode (the default) by its media at POST, a hard disk when sector 0
+has a partition table (in any of its four entries), else a floppy, also
+without media; or always as a floppy (2) or a hard disk (3). As with old
+BIOSes, the mapping stays until the next boot. A ZIP floppy handles media
+changes as the LS-120 does, with the 64-head/32-sector geometry of
+Iomega's BIOS translation.
+
+An LS-120 is registered as a floppy drive with or without media at POST.
+As the ATAPI Removable Media Device BIOS Specification describes, INT 13h
+checks the media before each access (TEST UNIT READY, REQUEST SENSE): no
+media returns 80h, a media change (UNIT ATTENTION) is reported by AH=16h,
+and new media is identified by READ CAPACITY, with geometry from a table of
+720-KB, 1.44-MB and 120-MB media, or else from the Flexible Disk mode page.
+AH=08h reports a 1.44-MB geometry and drive type 10h without media, and
+AH=15h reports change-line support.
+
+DOS BIOS diagnostic
+-------------------
+
+With NASM 2.x, build a DOS diagnostic (no ASPI manager needed):
+
+    nasm -f bin tests/bios-ls120.asm -o /tmp/BIOSTEST.COM
+
+Run BIOSTEST.COM under DOS using disposable test media in BIOS drive 00h.
+It checks geometry and boot-sector reads, then writes/reads the last CHS
+sector and restores its previous contents. It reports success through DOS
+standard output. Use `BIOSTEST > AUX` to capture it through a VM's COM1.
+
+The diagnostic passed with MS-DOS 7.1 booted from an emulated ATAPI LS-120
+with 1.44-MB media in an isolated 86Box fixture. That fixture supplies a
+standalone BIOS platform and the same `etc/floppy-a` ROM file that ReBIOS
+publishes through CSM; it does not run the ReBIOS hypervisor or emulate
+an IDE-to-SATA bridge. Keep those validation scopes distinct.
+
+AHCI ATAPI transport checks
+--------------------------
+
+With Python 3, GCC (or CC=clang), AddressSanitizer and UBSan:
+
+    python3 tests/ahci-atapi.py
+
+This compiles the production CDB builder, ATAPI FIS preparation and AHCI
+ATAPI transfer functions with a mock DMA submission boundary. It verifies
+aligned and odd-address read/write buffers, multi-sector bounce copies,
+write direction, failure propagation, CD write protection, and rejection
+of unaligned pre-built SCSI requests. It does not emulate an AHCI controller
+or qualify a physical SATA bridge.
+
+DOS integration results
+-----------------------
+
+With the media-change support, an isolated 86Box PATA fixture booted MS-DOS
+7.1 (HIMEM, EMM386) from its hard disk with the LS-120 empty. INT 13h
+reported 80h for a read and a 1.44-MB/type-10h geometry; a 1.44-MB disk
+inserted afterwards was read by the BIOS and listed by DOS (DIR A:); after
+swapping in native 120-MB media, AH=16h reported the change, AH=08h the
+963/8/32 geometry, and DOS listed and read the new disk.
+
+An isolated 86Box PATA fixture booted MS-DOS 7.1 from a 1.44-MB disk in an
+ATAPI LS-120 as A:, then completed an installation through four setup disks,
+including FDISK, reboot, FORMAT, SYS and three media swaps. A native 120-MB
+FAT16 superfloppy also passed BIOS and DOS reads/writes, SYS and boot as A:.
+The installed DOS system used HIMEM/EMM386 for the native-media read/write
+checks; the fixture's KEYB startup line was omitted to isolate storage.
+
+Use BIOS drive 00h in the BPB of a bootable LS-120 superfloppy (for example
+`mkfs.fat -D 0` when preparing the fixture on Linux). Large FAT16 media may
+otherwise default to drive 80h, and DOS SYS preserves that byte.
+
+With an LS-120 (empty, A:) and a ZIP 100 on one IDE channel, booted from
+the hard disk: partitioned ZIP media at boot (partition in slot 4 or slot 1)
+became hard disk D:; a superfloppy at boot became B:; an empty ZIP became B:
+and a superfloppy inserted afterwards was listed and read through B:. Forced
+floppy mode kept partitioned media off D:; forced hard-disk mode registered
+no drive without media.
+
+ATAPI ZIP100 and ZIP250 passed BIOS reads/writes, DOS file copies with and
+without VERIFY, SYS, and DOS 7.1 boot from active type-06 FAT16 partitions
+in MBR slot 4, starting at LBA 32. They remain hard disks. Their legacy CHS
+boot sectors require 64 heads and 32 sectors/track in both the BIOS geometry
+and FAT BPB. Booted file copies matched the original 100,000-byte payload
+by SHA-256, and FAT checks passed after shutdown.
diff --git a/tests/ahci-atapi.py b/tests/ahci-atapi.py
new file mode 100644
index 00000000..26b36f8f
--- /dev/null
+++ b/tests/ahci-atapi.py
@@ -0,0 +1,151 @@
+#!/usr/bin/env python3
+"""Test production ATAPI command/bounce code with a host-side DMA boundary."""
+import os
+from pathlib import Path
+import shlex
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[1]
+
+
+def function(path, signature):
+    """Compile the actual functions, leaving hardware initialization outside."""
+    source = (root / path).read_text()
+    start = source.index(signature)
+    brace = source.index("{", start)
+    depth = 1
+    end = brace + 1
+    while depth:
+        depth += (source[end] == "{") - (source[end] == "}")
+        end += 1
+    return source[start:end] + "\n"
+
+
+prefix = r'''
+#include "hw/ahci.h"
+#include "hw/blockcmd.h"
+#include "std/disk.h"
+#undef offsetof
+#define offsetof(t, m) __builtin_offsetof(t, m)
+#define CONFIG_AHCI 1
+#define MODESEGMENT 0
+#define GET_FLATPTR(x) (x)
+#define GET_SEG(x) 0
+#define MAKE_FLATPTR(seg, off) ((void *)(off))
+#define cpu_to_be16(x) __builtin_bswap16(x)
+#define cpu_to_be32(x) __builtin_bswap32(x)
+#define cpu_to_be64(x) __builtin_bswap64(x)
+#define memset __builtin_memset
+#define memcpy __builtin_memcpy
+#define memset_fl __builtin_memset
+#define memcpy_fl __builtin_memcpy
+#define ATA_CMD_PACKET 0xa0
+#define CDROM_CDB_SIZE 12
+#define CHECK(x) do { if (!(x)) return (__LINE__ % 250) + 1; } while (0)
+static u8 bounce[2048] __attribute__((aligned(2)));
+static u8 bytes[1538] __attribute__((aligned(2)));
+u8 *bounce_buf_fl = bounce;
+static unsigned int calls, bad, fail_on;
+static const u8 *expected;
+int default_process_op(struct disk_op_s *op) { (void)op; return DISK_RET_EPARAM; }
+#define AHCI_UNIT_ATTENTION -2
+static int ahci_atapi_request_sense(struct ahci_port_s *port)
+{
+    (void)port;
+    return -1;
+}
+static int ahci_command(struct ahci_port_s *port, int write, int atapi,
+                        void *buffer, u32 length)
+{
+    struct cdb_rwdata_10 *cdb = (void *)port->cmd->atapi;
+    u32 lba = __builtin_bswap32(cdb->lba);
+    u16 count = __builtin_bswap16(cdb->count);
+    bad |= !atapi || port->cmd->fis.command != ATA_CMD_PACKET;
+    bad |= port->cmd->fis.feature != 1 || length != count * 512;
+    bad |= cdb->command != (write ? CDB_CMD_WRITE_10 : CDB_CMD_READ_10);
+    calls++;
+    if (calls == fail_on)
+        return -1;
+    u8 *data = buffer;
+    u32 i;
+    for (i = 0; i < length; i++) {
+        if (write)
+            bad |= data[i] != expected[(lba - 100) * 512 + i];
+        else
+            data[i] = (u8)(lba + i / 512);
+    }
+    return 0;
+}
+'''
+
+suffix = r'''
+int main(void)
+{
+    struct ahci_cmd_s command = {0};
+    struct ahci_port_s port = {.drive = {.blksize = 512}, .cmd = &command};
+    struct disk_op_s op = {.drive_fl = &port.drive, .lba = 100, .count = 2};
+    unsigned int i, odd;
+    for (odd = 0; odd < 2; odd++) {
+        op.buf_fl = bytes + odd;
+        expected = bytes + odd;
+        for (i = 0; i < 1024; i++)
+            bytes[odd + i] = (u8)(i * 7 + i / 512);
+        calls = bad = fail_on = 0;
+        op.command = CMD_WRITE;
+        CHECK(!ahci_atapi_process_op(&op));
+        CHECK(!bad && calls == (odd ? 2 : 1));
+        calls = bad = 0;
+        op.command = CMD_READ;
+        CHECK(!ahci_atapi_process_op(&op));
+        CHECK(!bad && calls == (odd ? 2 : 1));
+        for (i = 0; i < 1024; i++)
+            CHECK(bytes[odd + i] == 100 + i / 512);
+    }
+    calls = bad = 0;
+    fail_on = 2;
+    op.buf_fl = bytes + 1;
+    op.count = 3;
+    CHECK(ahci_atapi_process_op(&op) == DISK_RET_EBADTRACK);
+    CHECK(!bad && calls == 2);
+    calls = 0;
+    op.command = CMD_FORMAT;
+    CHECK(ahci_atapi_process_op(&op) == DISK_RET_EPARAM);
+    CHECK(!calls);
+    port.drive.blksize = 2048;
+    op.command = CMD_WRITE;
+    CHECK(ahci_atapi_process_op(&op) == DISK_RET_EWRITEPROTECT);
+    CHECK(!calls);
+    op.command = CMD_FORMAT;
+    CHECK(ahci_atapi_process_op(&op) == DISK_RET_EWRITEPROTECT);
+    CHECK(!calls);
+    port.drive.blksize = 512;
+    u8 cdb[16] = {CDB_CMD_INQUIRY};
+    op.command = CMD_SCSI;
+    op.cdbcmd = cdb;
+    op.blocksize = 36;
+    op.count = 1;
+    CHECK(ahci_atapi_process_op(&op) == DISK_RET_EBADTRACK);
+    CHECK(!calls);
+    return 0;
+}
+'''
+
+code = prefix
+code += function("src/hw/blockcmd.c", "int\nscsi_fill_cmd(")
+code += function("src/hw/ahci.c", "static void sata_prep_atapi(")
+code += function("src/hw/ahci.c", "static int\nahci_atapi_issue(")
+code += function("src/hw/ahci.c", "int ahci_atapi_process_op(")
+code += suffix
+with tempfile.TemporaryDirectory(prefix="seabios-ahci-") as tmp:
+    source = Path(tmp) / "test.c"
+    binary = Path(tmp) / "test"
+    source.write_text(code)
+    cc = shlex.split(os.environ.get("CC", "cc"))
+    subprocess.run(cc + ["-Isrc", "-Wall", "-Wextra", "-Werror",
+                        "-Wno-pointer-to-int-cast",
+                        "-fsanitize=address,undefined", "-g", str(source),
+                        "-o", str(binary)], cwd=root, check=True)
+    env = dict(os.environ, ASAN_OPTIONS="detect_leaks=0")
+    subprocess.run([str(binary)], env=env, check=True)
+print("AHCI ATAPI aligned/unaligned reads/writes, errors and CD protection passed")
diff --git a/tests/atapi-floppy.c b/tests/atapi-floppy.c
new file mode 100644
index 00000000..51ba8c52
--- /dev/null
+++ b/tests/atapi-floppy.c
@@ -0,0 +1,129 @@
+// Host tests of the geometry and model matching used by the ATAPI drivers.
+#include "../src/hw/atapi-floppy.h"
+
+#define CHECK(test) do { if (!(test)) return __LINE__; } while (0)
+
+int main(void)
+{
+    CHECK(atapi_is_superdisk("MATSHITA LS-120 VER5 00"));
+    CHECK(atapi_is_superdisk("LS120 SLIM"));
+    CHECK(atapi_is_superdisk("MATSHITA ls-120 COSM 04"));
+    CHECK(!atapi_is_superdisk("IOMEGA ZIP 100 ATAPI"));
+    CHECK(!atapi_is_superdisk("LS-1200"));
+    CHECK(!atapi_is_superdisk(""));
+    CHECK(!atapi_is_superdisk("L"));
+    CHECK(!atapi_is_superdisk("LS"));
+    CHECK(!atapi_is_superdisk("LS-"));
+    CHECK(!atapi_is_superdisk("LS-1"));
+    CHECK(!atapi_is_superdisk("LS-12"));
+    CHECK(atapi_is_superdisk("LS-240 COSM 01"));
+    CHECK(atapi_is_superdisk("LS240"));
+    CHECK(!atapi_is_superdisk("LS-2400"));
+    CHECK(atapi_is_superdisk("TEAC UHD Floppy"));
+    CHECK(!atapi_is_superdisk("IOMEGA ZIP 100 ATAPI Floppy"));
+
+    struct chs_s chs;
+    u8 type;
+    CHECK(!atapi_floppy_geometry(2880, &chs, &type));
+    CHECK(chs.cylinder == 80 && chs.head == 2 && chs.sector == 18);
+    CHECK(type == 4);
+    CHECK(!atapi_floppy_geometry(246528, &chs, &type));
+    CHECK(type == ATAPI_FLOPPY_TYPE_ARMD);
+    CHECK(atapi_floppy_geometry(196608, &chs, &type));
+    // An LS-240 page: 262 cylinders, 32 heads, 56 sectors (469504 blocks).
+    CHECK(!atapi_floppy_page_geometry(469504, 32, 56, 262, &chs, &type));
+    CHECK(chs.cylinder == 262 && chs.head == 32 && chs.sector == 56);
+    CHECK(type == ATAPI_FLOPPY_TYPE_ARMD);
+    CHECK(atapi_floppy_page_geometry(469505, 32, 56, 262, &chs, &type));
+    CHECK(atapi_floppy_page_geometry(64 * 2 * 1100, 2, 64, 1100, &chs, &type));
+    CHECK(atapi_floppy_page_geometry(0, 0, 0, 0, &chs, &type));
+    CHECK(!atapi_floppy_large_geometry(196608, &chs, &type)); // ZIP 100
+    CHECK(chs.cylinder == 96 && chs.head == 64 && chs.sector == 32);
+    CHECK(!atapi_floppy_large_geometry(489532, &chs, &type)); // ZIP 250
+    CHECK(chs.cylinder == 239 && type == ATAPI_FLOPPY_TYPE_ARMD);
+    CHECK(atapi_floppy_large_geometry(2047, &chs, &type));
+    CHECK(atapi_floppy_large_geometry(1025 * 2048, &chs, &type));
+
+    CHECK(atapi_is_zip("IOMEGA", "ZIP 100", "bridge"));
+    CHECK(atapi_is_zip("ATA", "disk", "IOMEGA ZIP 250 ATAPI"));
+    CHECK(!atapi_is_zip("MATSHITA", "LS-120 COSM 04", "LS-120"));
+
+    static u8 sector[512];
+    CHECK(!atapi_media_has_mbr(sector));
+    sector[510] = 0x55;
+    sector[511] = 0xaa;
+    CHECK(!atapi_media_has_mbr(sector)); // No partition.
+    sector[446 + 3 * 16 + 4] = 0x06;     // Iomega's partition 4, FAT16.
+    CHECK(atapi_media_has_mbr(sector));
+    sector[446] = 0x12;                  // Not a status byte.
+    CHECK(!atapi_media_has_mbr(sector));
+    sector[446] = 0x80;
+    CHECK(atapi_media_has_mbr(sector));
+    // A FAT boot sector (superfloppy) whose BPB bytes look like entries.
+    sector[0] = 0xeb;
+    sector[11] = 0x00;
+    sector[12] = 0x02;
+    sector[13] = 32;
+    sector[16] = 2;
+    CHECK(!atapi_media_has_mbr(sector));
+    sector[13] = 3;                      // Not a cluster size: an MBR.
+    CHECK(atapi_media_has_mbr(sector));
+
+    struct atapi_media_s media = { .state = ATAPI_MEDIA_READY };
+    atapi_media_none(&media);
+    CHECK(media.state == ATAPI_MEDIA_NONE && media.sectors == 0);
+    CHECK(media.lchs.cylinder == 80 && media.lchs.head == 2);
+    CHECK(media.lchs.sector == 18);
+    CHECK(media.floppy_type == ATAPI_FLOPPY_TYPE_ARMD);
+    CHECK(atapi_model_matches("ATAPI [AHCI/1: MATSHITA LS-120]", "ls-120"));
+    CHECK(!atapi_model_matches("IOMEGA ZIP 100", "LS-120"));
+    CHECK(!atapi_model_matches("LS-120", "LS-120 VER5"));
+    CHECK(!atapi_model_matches("LS-120", ""));
+
+    struct drive_s drive = { .blksize = 512 };
+    drive.sectors = 1440;
+    CHECK(!atapi_floppy_setup(&drive));
+    CHECK(drive.floppy_type == 3);
+    CHECK(drive.lchs.head == 2 && drive.lchs.cylinder == 80);
+    CHECK(drive.lchs.sector == 9);
+    drive.sectors = 2880;
+    CHECK(!atapi_floppy_setup(&drive));
+    CHECK(drive.floppy_type == 4 && drive.lchs.sector == 18);
+    drive.sectors = 246528;
+    CHECK(!atapi_floppy_setup(&drive));
+    CHECK(drive.floppy_type == 0x10);
+    CHECK(drive.lchs.head == 8 && drive.lchs.cylinder == 963);
+    CHECK(drive.lchs.sector == 32);
+    CHECK((u64)drive.lchs.head * drive.lchs.cylinder * drive.lchs.sector
+          == drive.sectors);
+    CHECK(drive.pchs.head == drive.lchs.head);
+    CHECK(drive.pchs.cylinder == drive.lchs.cylinder);
+    CHECK(drive.pchs.sector == drive.lchs.sector);
+    drive.sectors = 0;
+    CHECK(atapi_floppy_setup(&drive));
+    drive.sectors = 196608; // ZIP capacity must not become a SuperDisk floppy.
+    CHECK(atapi_floppy_setup(&drive));
+    drive.sectors = 246528;
+    drive.blksize = 2048;
+    CHECK(atapi_floppy_setup(&drive));
+    drive = (struct drive_s){ .blksize = 512, .removable = 1,
+                              .sectors = 196608 };
+    CHECK(atapi_zip_setup(&drive, "IOMEGA", "ZIP 100", "bridge"));
+    CHECK(drive.lchs.head == 64 && drive.lchs.sector == 32);
+    CHECK(drive.lchs.cylinder == 96);
+    drive.lchs = (struct chs_s){0};
+    drive.sectors = 489532;
+    CHECK(atapi_zip_setup(&drive, "bridge", "device", "IOMEGA ZIP 250 ATAPI"));
+    CHECK(drive.lchs.cylinder == 239);
+    drive.lchs = (struct chs_s){ .head = 16, .sector = 63, .cylinder = 485 };
+    CHECK(!atapi_zip_setup(&drive, "IOMEGA", "ZIP 250", "IOMEGA ZIP"));
+    CHECK(drive.lchs.head == 16 && drive.lchs.sector == 63);
+    drive.lchs = (struct chs_s){0};
+    CHECK(!atapi_zip_setup(&drive, "OTHER", "disk", "disk"));
+    drive.sectors = 1000000;
+    CHECK(!atapi_zip_setup(&drive, "IOMEGA", "ZIP 250", "IOMEGA ZIP"));
+    drive.sectors = 196608;
+    drive.removable = 0;
+    CHECK(!atapi_zip_setup(&drive, "IOMEGA", "ZIP 100", "IOMEGA ZIP"));
+    return 0;
+}
diff --git a/tests/bios-ls120.asm b/tests/bios-ls120.asm
new file mode 100644
index 00000000..22031247
--- /dev/null
+++ b/tests/bios-ls120.asm
@@ -0,0 +1,81 @@
+; DOS .COM: BIOS A: geometry, boot-sector read, last-sector write/read/restore.
+; Use only with disposable test images. No ASPI or filesystem driver involved.
+bits 16
+org 100h
+start:
+    push ds
+    pop es
+    xor dx,dx
+    mov ah,08h
+    int 13h
+    jc failed
+    or dl,dl
+    jz failed
+    and dx,0ff00h
+    mov [last_cx],cx
+    mov [last_dx],dx
+    mov ax,ds
+    mov es,ax
+    mov bx,saved
+    mov ax,0201h
+    mov cx,1
+    xor dx,dx
+    int 13h
+    jc failed
+    cmp word [saved+510],0aa55h
+    jne failed
+    cmp word [saved+11],512
+    jne failed
+    mov ax,0201h
+    mov bx,saved
+    call last_sector
+    jc failed
+    mov di,pattern
+    mov cx,256
+    mov ax,0a55ah
+    rep stosw
+    mov ax,0301h
+    mov bx,pattern
+    call last_sector
+    jc restore_failed
+    mov ax,0201h
+    mov bx,readback
+    call last_sector
+    jc restore_failed
+    mov si,pattern
+    mov di,readback
+    mov cx,256
+    repe cmpsw
+    jne restore_failed
+    mov ax,0301h
+    mov bx,saved
+    call last_sector
+    jc failed
+    mov dx,passed
+    mov ah,09h
+    int 21h
+    mov ax,4c00h
+    int 21h
+restore_failed:
+    mov ax,0301h
+    mov bx,saved
+    call last_sector
+failed:
+    mov dx,failure
+    mov ah,09h
+    int 21h
+    mov ax,4c01h
+    int 21h
+last_sector:
+    mov cx,[last_cx]
+    mov dx,[last_dx]
+    int 13h
+    ret
+last_cx dw 0
+last_dx dw 0
+passed db 'BIOS LS120 A: read/write/restore passed',13,10,'$'
+failure db 'BIOS LS120 A: FAILED',13,10,'$'
+align 2
+saved times 512 db 0
+pattern times 512 db 0
+readback times 512 db 0
